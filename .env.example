# Modelo das variáveis do docker-compose.yml. NÃO coloque valor real aqui.
# No Dokploy: colar o conteúdo (com os valores de verdade) na aba
# Environment do serviço Compose — o Dokploy grava isso num .env ao lado
# do docker-compose.yml, e o compose lê de lá.
#
# Gerar segredos (só [0-9a-f], então é seguro dentro de URL sem escapar):
#   openssl rand -hex 24
# ou, no Windows:  py -c "import secrets; print(secrets.token_hex(24))"

# ---------------------------------------------------------------------------
# Postgres dedicado deste projeto (serviço faturas-db). O compose monta o
# DATABASE_URL a partir destes três:
#   postgresql+psycopg://POSTGRES_USER:POSTGRES_PASSWORD@faturas-db:5432/POSTGRES_DB
# Não use @ : / ? # na senha (quebra a URL) — o hex acima evita isso.
# ATENÇÃO: o Postgres só lê estas variáveis na PRIMEIRA inicialização do
# volume. Trocar a senha depois exige ALTER USER dentro do banco.
POSTGRES_DB=faturas
POSTGRES_USER=faturas
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Storage S3 (serviço faturas-storage). Credencial ROOT: só o one-shot
# faturas-storage-init e você (console/mcli) usam. Mínimo 8 caracteres.
STORAGE_ROOT_USER=faturas-admin
STORAGE_ROOT_PASSWORD=

# Credencial RESTRITA da app/worker (criada pelo faturas-storage-init com
# política que só enxerga S3_BUCKET). Secret com no mínimo 8 caracteres.
S3_ACCESS_KEY=faturas-app
S3_SECRET_KEY=
S3_BUCKET=faturas-agua
S3_REGION=us-east-1
# S3_ENDPOINT_URL é fixado no compose (http://faturas-storage:9000).

# ---------------------------------------------------------------------------
# App
# Acesso por http://IP-DA-VPS:APP_PORTA (sem domínio). Escolha uma porta que
# nenhum outro projeto da VPS use (Toca: 5000-5003; Dokploy: 3000; Traefik: 80/443).
APP_PORTA=8090
# Usuário/senha que o navegador pede ao abrir a interface (Basic Auth).
# Obrigatórios: sem domínio não há proxy na frente, e sem isso qualquer um
# que achar a porta vê as faturas. /health fica sem senha (healthcheck).
APP_USUARIO=faturas
APP_SENHA=
# Porta DENTRO do container (não mexer).
PORT=8000
# Vazio = acha o tesseract no PATH (/usr/bin/tesseract na imagem).
TESSERACT_CMD=
# CONTAS_JSON_PATH é fixado no compose em /app/contas.json (File Mount do
# Dokploy). Não tem valor aqui porque o arquivo NÃO vai pro git.

# ---------------------------------------------------------------------------
# Só para rodar FORA do compose (dev local apontando pra um Postgres/S3
# seus). Dentro do compose estes valores são montados automaticamente.
# DATABASE_URL=postgresql+psycopg://faturas:SENHA@localhost:5432/faturas
# S3_ENDPOINT_URL=http://localhost:9000
# CONTAS_JSON_PATH=./contas.json
